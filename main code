        function drawScorers() {
            if (displayMode === 'time') return;      // no goals before kick-off
            const gap = getGap();
            // each column is centred under its "score + crest" group
            const cols = [
                { rows: getScorers('scorers1List'), cx: SCORE_X[0] - gap / 2 },
                { rows: getScorers('scorers2List'), cx: SCORE_X[1] + gap / 2 }
            ];
            ctx.save();
            ctx.fillStyle = theme === 'dark' ? '#FFFFFF' : '#111111';
            cols.forEach(col => {
                const n = col.rows.length;
                if (!n) return;
                const names = col.rows.map(r => r.name.toLocaleUpperCase('pl'));
                const lh = Math.min(42, (SCORERS_BOTTOM - SCORERS_TOP) / n);
                let size = Math.min(32, Math.round(lh * 0.8));

                // layout: [minute] [ball] [name]; minute column right-aligned, names left-aligned
                const layout = sz => {
                    const mw = Math.max.apply(null, col.rows.map(r => r.minute ? machineWidth(r.minute, sz) : 0));
                    const nw = Math.max.apply(null, names.map(t => machineWidth(t, sz)));
                    const g = sz * 0.4, ball = sz * 0.8;
                    return { mw, nw, g, ball, total: (mw ? mw + g : 0) + ball + g + nw };
                };
                let L = layout(size);
                if (L.total > SCORERS_MAX_W) { size = Math.max(10, size * SCORERS_MAX_W / L.total); L = layout(size); }

                const left = col.cx - L.total / 2;
                const capH = size * CAP_RATIO;
                col.rows.forEach((r, i) => {
                    const yc = SCORERS_TOP + lh * (i + 0.5);
                    const base = yc + capH / 2;
                    let x = left;
                    if (L.mw) {
                        if (r.minute) machineDraw(r.minute, x + L.mw - machineWidth(r.minute, size), base, size);
                        x += L.mw + L.g;
                    }
                    if (ballImg.complete && ballImg.naturalWidth) ctx.drawImage(ballImg, x, yc - L.ball / 2, L.ball, L.ball);
                    x += L.ball + L.g;
                    machineDraw(names[i], x, base, size);
                });
            });
            ctx.restore();
        }

        // ---------- Team logos ----------
        function drawPlaceholder(cx, cy, label) {
