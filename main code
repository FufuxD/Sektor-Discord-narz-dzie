    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sektor Discord - Generator Wyników</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;800;900&family=Anton&display=swap" rel="stylesheet">

    <style>
        /* ITC Machine (brand font) is embedded in this file, so no extra files are needed */
        @font-face {
            font-family: 'ITCMachine';
            src: url(data:font/otf;base64,) format('opentype');
            font-weight: 400;
            font-style: normal;
        }

        body { font-family: 'Montserrat', sans-serif; background-color: #09090b; color: #ffffff; }
        .font-machine { font-family: 'ITCMachine', sans-serif; font-weight: 400; letter-spacing: 1px; }

        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #121215; }
        ::-webkit-scrollbar-thumb { background: #5D52A3; border-radius: 3px; }

        .search-results-dropdown {
            max-height: 300px;
            overflow-y: auto;
            z-index: 100;
            box-shadow: 0 10px 25px -5px rgba(0,0,0,.8), 0 8px 10px -6px rgba(0,0,0,.5);
        }
        .result-item.active { background: #eeeaff; }
        .seg-btn.on { background: #5D52A3; color: #fff; }
    </style>
</head>
