        // ---------- Remote logo loading (CORS-safe so PNG export keeps working) ----------
        function loadImageCORS(url) {
            return new Promise((resolve, reject) => {
                const img = new Image();
                img.crossOrigin = 'anonymous';
                img.onload = () => resolve(img);
                img.onerror = () => reject(new Error('image load failed'));
                img.src = url;
            });
        }

        async function fetchLogo(url) {
            const attempts = [
                () => loadImageCORS(url),
                async () => {
                    const res = await fetch(url, { mode: 'cors' });
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    return loadImageCORS(URL.createObjectURL(await res.blob()));
                },
                () => loadImageCORS('https://wsrv.nl/?output=png&url=' + encodeURIComponent(url))
            ];
            let lastErr;
            for (const run of attempts) {
                try {
                    const img = await run();
                    if (img.naturalWidth > 0) return img;   // SVG without intrinsic size would draw as nothing
                } catch (e) { lastErr = e; }
            }
            throw lastErr || new Error('logo load failed');
