                '<defs><clipPath id="bc"><circle cx="50" cy="50" r="46"/></clipPath></defs>' +
                '<circle cx="50" cy="50" r="46" fill="#fff"/>' +
                '<g clip-path="url(#bc)" fill="#111" stroke="#111" stroke-linejoin="round">' +
                '<polygon points="' + pent(50, 50, 20, -Math.PI / 2) + '" stroke-width="2"/>' +
                '<path d="' + seams + '" fill="none" stroke-width="3.5"/>' + patches + '</g>' +
