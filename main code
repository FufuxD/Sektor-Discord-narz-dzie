    <script>
        lucide.createIcons();

        // ---------- Canvas: template size 1350 x 600 ----------
        const W = 1350, H = 600;
        const BRAND_PURPLE = '#5D52A3';
        const canvas = document.getElementById('matchCanvas');
        const ctx = canvas.getContext('2d');
        canvas.width = W;
        canvas.height = H;

        // Approved templates are embedded as images (dark = original, light = same design with inverted black/white)
        const TEMPLATES = { dark: new Image(), light: new Image() };
        TEMPLATES.dark.onload = TEMPLATES.light.onload = () => renderGraphic();
        TEMPLATES.dark.src = "data:image/png;base64,";
        TEMPLATES.light.src = "data:image/png;base64,";

        let theme = 'dark';
        const loadedLogos = { team1: null, team2: null, comp: null };

        // layout constants (canvas px)
        const SCORE_X = [520, 840];     // score centres, symmetric around the SD logo (x = 680)
        const CENTER_Y = 279;           // vertical centre of the SD logo
        const SCORE_SIZE = 170;         // ITC Machine font size for the digits
        const CAP_RATIO = 0.706;        // cap height of ITC Machine / em
        const LOGO_MAX = 190;

        function getGap() { return parseInt(document.getElementById('gapInput').value, 10) || 190; }

        function getOutline() {
            const on = document.getElementById('outlineOn').checked;
            let color = document.getElementById('outlineColor').value;
            if (color === 'auto') color = theme === 'dark' ? '#FFFFFF' : '#000000';
            return { on, color, width: parseInt(document.getElementById('outlineWidth').value, 10) || 0 };
        }

        function renderGraphic() {
            ctx.setTransform(1, 0, 0, 1, 0, 0);
            ctx.fillStyle = theme === 'dark' ? '#000000' : '#FFFFFF';
            ctx.fillRect(0, 0, W, H);
            const t = TEMPLATES[theme];
            if (t.complete && t.naturalWidth) ctx.drawImage(t, 0, 0, W, H);
            drawCompetition();
            drawScores();
            drawScorers();
            drawTeamLogos();
        }

        // make sure the brand font is ready before drawing digits
        Promise.all([
            document.fonts.load("170px ITCMachine"),
            document.fonts.load("800 40px Montserrat"),
            document.fonts.load("600 24px Montserrat"),
            document.fonts.load("100px Anton"),
            document.fonts.ready
        ]).then(renderGraphic).catch(renderGraphic);

        // ---------- Scores (Impact; Anton / Arial Black as fallbacks) ----------
        const SCORE_FONT = "Impact, 'Anton', 'Arial Black', sans-serif";
        const SCORE_TARGET_H = 124;     // height of the digits in canvas px (whatever font is actually used)
        function scoreMetrics() {
            ctx.save();
            ctx.font = '100px ' + SCORE_FONT;
            const asc = ctx.measureText('0').actualBoundingBoxAscent;
            ctx.restore();
            return { size: asc > 0 ? SCORE_TARGET_H / asc * 100 : SCORE_SIZE, h: SCORE_TARGET_H };
        }

        // "score" mode shows the result; "time" mode shows the start time (hours | SD logo | minutes)
        let displayMode = 'score';
        const pad2 = (id, max) => String(Math.min(max, Math.max(0, parseInt(document.getElementById(id).value, 10) || 0))).padStart(2, '0');
        function getDisplayValues() {
            if (displayMode === 'time') return [pad2('timeH', 23), pad2('timeM', 59)];
            return [document.getElementById('score1Input').value || '0', document.getElementById('score2Input').value || '0'];
        }

        function drawScores() {
            const [s1, s2] = getDisplayValues();
            ctx.save();
            ctx.fillStyle = theme === 'dark' ? '#FFFFFF' : '#000000';
            const sm = scoreMetrics();
            ctx.font = sm.size + "px " + SCORE_FONT;
            ctx.textAlign = 'center';
            ctx.textBaseline = 'alphabetic';
            const baseline = CENTER_Y + sm.h / 2;
            ctx.fillText(s1, SCORE_X[0], baseline);
            ctx.fillText(s2, SCORE_X[1], baseline);
            ctx.restore();
        }

        // ---------- ITC Machine text engine ----------
        // ITC Machine is a caps-only font without Ą Ć Ę Ń Ś Ź Ż (and some other accented letters). Missing letters are
        // composed from the font's own glyphs: the base letter + the accent cut out of a donor glyph (É, Š...).
        const MACHINE_FONT = "'ITCMachine', 'Montserrat', sans-serif";
        // Glyph detection at runtime: a character is "in the font" when it measures the same with two different
        // fallback fonts behind ITCMachine. So if the embedded font is replaced by a version with Polish letters,
        // those letters are used directly and nothing is composed.
        const machineGlyphCache = new Map();
        const MACHINE_HAS = {
            has(ch) {
                if (ch.length === 1 && ch.charCodeAt(0) < 0x7F) return true;
                if (machineGlyphCache.has(ch)) return machineGlyphCache.get(ch);
                ctx.save();
                ctx.font = '100px ITCMachine, serif';
                const a = ctx.measureText(ch).width;
                ctx.font = '100px ITCMachine, monospace';
                const b = ctx.measureText(ch).width;
                ctx.restore();
                const ok = Math.abs(a - b) < 0.01;
                if (document.fonts.check('100px ITCMachine')) machineGlyphCache.set(ch, ok);
                return ok;
            }
        };
        const MARK_DONORS = { '\u0301': 'É', '\u030C': 'Š', '\u0300': 'È', '\u0302': 'Ê', '\u0308': 'Ë', '\u0303': 'Ñ' };

        function machineTokens(text) {
            const tokens = [];
            let run = '';
            const flush = () => { if (run) { tokens.push({ t: 'run', text: run }); run = ''; } };
            Array.from(text).forEach(ch => {
                if (MACHINE_HAS.has(ch)) { run += ch; return; }
                const parts = Array.from(ch.normalize('NFD'));
                const base = parts[0], marks = parts.slice(1);
                const ok = marks.length && MACHINE_HAS.has(base) &&
                    marks.every(m => MARK_DONORS[m] || m === '\u0307' || m === '\u0328');
                if (ok) { flush(); tokens.push({ t: 'comp', base, marks }); }
                else run += ch;           // glyph the font really lacks -> browser falls back to Montserrat
            });
            flush();
            return tokens;
        }

        function machineWidth(text, size) {
            ctx.save();
            ctx.font = size + 'px ' + MACHINE_FONT;
            let w = 0;
            machineTokens(text).forEach(tk => { w += ctx.measureText(tk.t === 'run' ? tk.text : tk.base).width; });
            ctx.restore();
            return w;
        }

        function drawMark(m, x, y, size, base) {
            const u = size / 1000;
            const inkL = -base.actualBoundingBoxLeft, inkR = base.actualBoundingBoxRight;
            const center = (inkL + inkR) / 2;
            if (m === '\u0307') {                                   // dot above (Ż)
                ctx.fillRect(x + center - 53 * u, y - 869 * u, 106 * u, 115 * u);
                return;
            }
            if (m === '\u0328') {                                   // ogonek (Ą, Ę): small hook under the right foot
                const R = x + inkR;
                ctx.fillRect(R - 130 * u, y, 100 * u, 95 * u);
                ctx.fillRect(R - 40 * u, y + 55 * u, 70 * u, 40 * u);
                return;
            }
            const donor = MARK_DONORS[m];
            const dm = ctx.measureText(donor);
            const dx = center - (dm.actualBoundingBoxRight - dm.actualBoundingBoxLeft) / 2;
            ctx.save();
            ctx.beginPath();
            ctx.rect(x - size, y - 0.95 * size, size * 3, 0.95 * size - 0.725 * size);   // only the band above the cap height
            ctx.clip();
            ctx.fillText(donor, x + dx, y);
            ctx.restore();
        }

        // draws left-aligned at x on baseline y, using the current fillStyle
        function machineDraw(text, x, y, size) {
            ctx.save();
            ctx.font = size + 'px ' + MACHINE_FONT;
            ctx.textAlign = 'left';
            ctx.textBaseline = 'alphabetic';
            let cx = x;
            machineTokens(text).forEach(tk => {
                if (tk.t === 'run') {
                    ctx.fillText(tk.text, cx, y);
                    cx += ctx.measureText(tk.text).width;
                    return;
                }
                ctx.fillText(tk.base, cx, y);
                const bm = ctx.measureText(tk.base);
                tk.marks.forEach(m => drawMark(m, cx, y, size, bm));
                cx += bm.width;
            });
            ctx.restore();
        }

