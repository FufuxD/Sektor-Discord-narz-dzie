        // Outline = coloured silhouette of the logo stamped on dense concentric rings (a morphological dilation),
        // so the border follows the real shape of the crest. Built once per logo/size/colour/width and cached.
        const outlineCache = new WeakMap();

        function buildOutline(img, w, h, color, width) {
            const key = [Math.round(w), Math.round(h), color, width].join('|');
            const cached = outlineCache.get(img);
            if (cached && cached.key === key) return cached;

            const sw = Math.ceil(w), sh = Math.ceil(h);
            const pad = Math.ceil(width) + 2;

            const sil = document.createElement('canvas');
            sil.width = sw; sil.height = sh;
            const s = sil.getContext('2d');
            s.drawImage(img, 0, 0, sw, sh);
            s.globalCompositeOperation = 'source-in';
            s.fillStyle = color;
            s.fillRect(0, 0, sw, sh);

            const out = document.createElement('canvas');
            out.width = sw + pad * 2; out.height = sh + pad * 2;
            const o = out.getContext('2d');
            const rings = Math.max(2, Math.ceil(width / 2));
            for (let k = 1; k <= rings; k++) {
                const r = width * k / rings;
                const steps = Math.max(16, Math.ceil(2 * Math.PI * r / 1.2));
                for (let i = 0; i < steps; i++) {
                    const a = (i / steps) * Math.PI * 2;
                    o.drawImage(sil, pad + Math.cos(a) * r, pad + Math.sin(a) * r);
                }
            }
            o.drawImage(sil, pad, pad);

            const res = { key, canvas: out, pad, sw, sh };
            outlineCache.set(img, res);
            return res;
        }

        function drawLogo(img, cx, cy, maxW, maxH) {
            maxH = maxH || maxW;
            let w = img.naturalWidth || maxW, h = img.naturalHeight || maxH;
            const k = Math.min(maxW / w, maxH / h);
            w *= k; h *= k;
            const x = cx - w / 2, y = cy - h / 2;
            ctx.imageSmoothingEnabled = true;
            ctx.imageSmoothingQuality = 'high';

            const o = getOutline();
            if (o.on && o.width > 0) {
                try {
                    const ol = buildOutline(img, w, h, o.color, o.width);
                    const sx = w / ol.sw, sy = h / ol.sh;
                    ctx.drawImage(ol.canvas, x - ol.pad * sx, y - ol.pad * sy, ol.canvas.width * sx, ol.canvas.height * sy);
                } catch (err) {
                    console.error('Outline error:', err);
                }
            }
            ctx.drawImage(img, x, y, w, h);
        }

