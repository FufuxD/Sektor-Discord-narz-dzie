        // ================== WIKIDATA-START ==================
        // Logo sources, in order of preference:
        //   1) Wikidata logo properties (P154 "logo image", P8972 "small logo", P2910 "icon") -> file on Wikimedia Commons
        //   2) the lead image of the club's Wikipedia article (usually the crest; includes non-free logos that
        //      are stored on Wikipedia itself and therefore have no Commons file / no P154)
        const WD_API = 'https://www.wikidata.org/w/api.php';
        const COMMONS_API = 'https://commons.wikimedia.org/w/api.php';
        const LOGO_PROPS = ['P154', 'P8972', 'P2910'];
        const WIKI_SITES = ['enwiki', 'plwiki', 'eswiki', 'dewiki', 'frwiki', 'itwiki', 'ptwiki', 'nlwiki'];
        // What counts as a hit is decided by the entity's "instance of" classes (P31), e.g. "association football club",
        // "sports club", "national association football team" for teams and "association football league",
        // "recurring sporting event" for competitions. The sport property (P641) is deliberately NOT used: a manga
        // about basketball has it too. A text description is only a fallback for items without any class.
        const KINDS = {
            team: {
                classRe: /club|team|squad|esports? organi[sz]ation/i,
                classNo: /season|stadium|match|rivalry|derby|fan |supporter|player|video game|film|league|cup|tournament|championship|competition|federation/i,
                descRe: /\b(club|team|klub|drużyn\w*|reprezentacj\w*|zespół|squad)\b/i,
                descNo: /player|footballer|coach|manager|referee|trener|piłkarz|zawodnik|stadium|stadion|season|sezon|film|manga|novel|book|album|song|series|serial|video game|league|competition|tournament|championship|rozgrywk|turniej|mistrzostw/i
            },
            competition: {
                classRe: /league|tournament|cup|championship|competition|trophy|games|series|recurring|sporting event|sports event|division|play-?off|grand prix|olympi/i,
                classNo: /season|edition|stage|round|match|final|player|fan |supporter|stadium|video game|film|album|song|fantasy|federation|governing|body|organi[sz]ation/i,
                descRe: /\b(league|cup|tournament|championship|competition|trophy|liga|puchar|turniej|mistrzostw\w*|rozgrywk\w*|superpuchar|supercup)\b/i,
                descNo: /season|sezon|edition|edycja|film|manga|novel|album|song|player|footballer|stadium|stadion|federation|federacja|związek|board game|video game/i
            }
        };
        const YEAR_RE = /\b(1[89]|20)\d{2}\b/;

        async function apiJson(fetchFn, base, params) {
            const url = base + '?' + new URLSearchParams(Object.assign({ format: 'json', origin: '*' }, params));
            const res = await fetchFn(url);
            if (!res.ok) throw new Error('HTTP ' + res.status);
            return res.json();
        }

        // best file name from a claim list of one property (preferred rank, else the current one, else the last)
        function pickFile(claims, prop) {
            const arr = (claims && claims[prop]) || [];
            const valid = arr.filter(c => c.rank !== 'deprecated' && c.mainsnak && c.mainsnak.snaktype === 'value'
                && c.mainsnak.datavalue && typeof c.mainsnak.datavalue.value === 'string');
            if (!valid.length) return null;
            const preferred = valid.find(c => c.rank === 'preferred');
            if (preferred) return preferred.mainsnak.datavalue.value;
            const current = valid.filter(c => !(c.qualifiers && c.qualifiers.P582));
            const chosen = current.length ? current[current.length - 1] : valid[valid.length - 1];
            return chosen.mainsnak.datavalue.value;
        }

        // Commons file names -> 500 px image URLs. Handles redirects (renamed files) and first-letter capitalisation,
        // which is what made many logos "disappear" before.
        async function resolveCommonsFiles(files, fetchFn) {
            const out = {};
            const uniq = [...new Set(files)];
            for (let i = 0; i < uniq.length; i += 40) {
                const chunk = uniq.slice(i, i + 40);
                const titles = chunk.map(f => 'File:' + f);
                try {
                    const com = await apiJson(fetchFn, COMMONS_API, {
                        action: 'query', prop: 'imageinfo', iiprop: 'url', iiurlwidth: '500',
                        redirects: '1', titles: titles.join('|')
                    });
                    const q = com.query || {};
                    const norm = {}, redir = {}, byTitle = {};
                    (q.normalized || []).forEach(n => { norm[n.from] = n.to; });
                    (q.redirects || []).forEach(r => { redir[r.from] = r.to; });
                    Object.values(q.pages || {}).forEach(p => {
                        const info = p.imageinfo && p.imageinfo[0];
                        if (info) byTitle[p.title] = info.thumburl || info.url;
                    });
                    chunk.forEach((f, idx) => {
                        let t = titles[idx];
                        if (norm[t]) t = norm[t];
                        if (redir[t]) t = redir[t];
                        if (norm[t]) t = norm[t];
                        if (byTitle[t]) out[f] = byTitle[t];
                    });
                } catch (e) { console.warn('Commons lookup failed', e); }
            }
            return out;
        }

        // Wikipedia lead images; pilicense=any is essential - by default only free images are returned and
        // almost every club crest is a non-free file.
        async function wikiPageImages(wanted, fetchFn) {
            const bySite = {};
            wanted.forEach(w => { (bySite[w.site] = bySite[w.site] || []).push(w); });
            const out = {};
            await Promise.all(Object.entries(bySite).map(async ([site, list]) => {
                const lang = site.replace(/wiki$/, '');
                try {
                    const data = await apiJson(fetchFn, 'https://' + lang + '.wikipedia.org/w/api.php', {
                        action: 'query', prop: 'pageimages', piprop: 'thumbnail', pithumbsize: '500',
                        pilicense: 'any', redirects: '1', titles: list.map(w => w.title).join('|')
                    });
                    const q = data.query || {};
                    const norm = {}, redir = {}, byTitle = {};
                    (q.normalized || []).forEach(n => { norm[n.from] = n.to; });
                    (q.redirects || []).forEach(r => { redir[r.from] = r.to; });
                    Object.values(q.pages || {}).forEach(p => {
                        if (p.thumbnail && p.thumbnail.source) byTitle[p.title] = p.thumbnail.source;
                    });
                    list.forEach(w => {
                        let t = w.title;
                        if (norm[t]) t = norm[t];
                        if (redir[t]) t = redir[t];
                        if (byTitle[t]) out[w.key] = byTitle[t];
                    });
                } catch (e) { console.warn('Wikipedia lookup failed (' + site + ')', e); }
            }));
            return out;
        }

        async function searchWikidata(q, kind, fetchFn) {
            fetchFn = fetchFn || fetch;
            const K = KINDS[kind] || KINDS.team;

            // 1) candidates by name, English + Polish labels/aliases (interleaved so both languages get a fair share)
            const langs = ['en', 'pl'];
            const settled = await Promise.allSettled(langs.map(l => apiJson(fetchFn, WD_API, {
                action: 'wbsearchentities', search: q, language: l, uselang: l, type: 'item', limit: '15'
            })));
            if (settled.every(r => r.status === 'rejected')) throw settled[0].reason;
            const lists = settled.map(r => (r.status === 'fulfilled' && r.value.search) || []);
            const seen = new Set(), candidates = [];
            const longest = Math.max.apply(null, lists.map(l => l.length));
            for (let i = 0; i < longest; i++) {
                lists.forEach(l => {
                    const it = l[i];
                    if (!it || seen.has(it.id)) return;
                    seen.add(it.id);
                    candidates.push({ id: it.id, label: it.label || (it.display && it.display.label && it.display.label.value) || it.id, desc: it.description || '' });
                });
            }
            if (!candidates.length) return [];
            const top = candidates.slice(0, 25);

            // 2) details: logo files, Wikipedia articles and the "instance of" classes
            const ent = await apiJson(fetchFn, WD_API, {
                action: 'wbgetentities', ids: top.map(c => c.id).join('|'),
                props: 'claims|sitelinks', sitefilter: WIKI_SITES.join('|')
            });
            const classIds = new Set();
            const info = top.map(c => {
                const e = (ent.entities && ent.entities[c.id]) || {};
                const claims = e.claims || {};
                const cls = (claims.P31 || []).map(cl => cl.mainsnak && cl.mainsnak.datavalue && cl.mainsnak.datavalue.value && cl.mainsnak.datavalue.value.id).filter(Boolean);
                cls.forEach(id => classIds.add(id));
                const files = [...new Set(LOGO_PROPS.map(p => pickFile(claims, p)).filter(Boolean).map(f => f.replace(/_/g, ' ')))];
                const wikis = WIKI_SITES.filter(st => e.sitelinks && e.sitelinks[st]).slice(0, 2)
                    .map(st => ({ site: st, title: e.sitelinks[st].title, key: c.id + ':' + st }));
                return Object.assign({}, c, { files, wikis, cls });
            });

            // English names of those classes
            const classLabel = {};
            if (classIds.size) {
                try {
                    const lab = await apiJson(fetchFn, WD_API, {
                        action: 'wbgetentities', ids: [...classIds].slice(0, 50).join('|'), props: 'labels', languages: 'en'
                    });
                    Object.values(lab.entities || {}).forEach(e => { if (e.labels && e.labels.en) classLabel[e.id] = e.labels.en.value.toLowerCase(); });
                } catch (e) { console.warn('Class lookup failed', e); }
            }

            const relevant = info.filter(c => {
                if (!c.files.length && !c.wikis.length) return false;
                const names = c.cls.map(id => classLabel[id]).filter(Boolean);
                let ok = names.length
                    ? names.some(n => K.classRe.test(n) && !K.classNo.test(n))
                    : (K.descRe.test(c.desc) && !K.descNo.test(c.desc));
                if (ok && kind === 'competition' && YEAR_RE.test(c.label)) ok = false;   // single editions ("2022 FIFA World Cup")
                return ok;
            });
            const pool = relevant.slice(0, 10);
            if (!pool.length) return [];

            // 3) resolve to image URLs: Commons logo files first, Wikipedia lead image as fallback
            const [commons, wiki] = await Promise.all([
                resolveCommonsFiles(pool.flatMap(c => c.files), fetchFn),
                wikiPageImages(pool.flatMap(c => c.wikis), fetchFn)
            ]);

            return pool.map(c => {
                const urls = [...new Set([...c.files.map(f => commons[f]), ...c.wikis.map(w => wiki[w.key])].filter(Boolean))];
                return { name: c.label, sub: c.desc || 'Wikidata', logo: urls[0] || '', alts: urls.slice(1), thumb: urls[0] || '' };
            }).filter(t => t.logo).slice(0, 8);
        }
        // =================== WIKIDATA-END ===================

        // ---------- Optional TheSportsDB (Premium key only: the free key allows only "Arsenal") ----------
        const KEY_STORE = 'sd_thesportsdb_key';
        const keyInput = document.getElementById('apiKeyInput');
        const sourceBadge = document.getElementById('sourceBadge');
        const searchCache = new Map();

        function getApiKey() { return keyInput.value.trim(); }
        function updateSourceBadge() { sourceBadge.textContent = getApiKey() ? 'TheSportsDB' : 'Wikidata'; }
        try { keyInput.value = localStorage.getItem(KEY_STORE) || ''; } catch (e) {}
        updateSourceBadge();
        keyInput.addEventListener('input', () => {
            try { localStorage.setItem(KEY_STORE, getApiKey()); } catch (e) {}
            updateSourceBadge();
            searchCache.clear();
        });

        async function searchSportsDB(q, key) {
            const res = await fetch('https://www.thesportsdb.com/api/v1/json/' + encodeURIComponent(key) + '/searchteams.php?t=' + encodeURIComponent(q));
            if (!res.ok) throw new Error('TheSportsDB: HTTP ' + res.status);
            const data = await res.json();
            return (data.teams || []).map(t => {
                const logo = t.strBadge || t.strTeamBadge || t.strLogo || '';
                return { name: t.strTeam, sub: (t.strSport || 'Sport') + ' • ' + (t.strLeague || t.strCountry || ''), logo, thumb: logo ? logo + '/tiny' : '' };
            });
        }

        async function searchTeams(q, kind) {
            const key = getApiKey();
            return (key && kind === 'team') ? searchSportsDB(q, key) : searchWikidata(q, kind);
        }

        function escapeHtml(str) {
            return String(str ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        }

        // ---------- Suggestions under the search bar ----------
        function setupTeamSearch(inputId, loaderId, resultsId, statusId, teamKey, kind) {
            kind = kind || 'team';
            const input = document.getElementById(inputId);
            const loader = document.getElementById(loaderId);
            const results = document.getElementById(resultsId);
            const status = document.getElementById(statusId);
            let timer = null, reqId = 0, activeIdx = -1;

            const closeList = () => { results.classList.add('hidden'); activeIdx = -1; };
            const rows = () => [...results.querySelectorAll('.result-item')];
            const highlight = () => rows().forEach((r, i) => r.classList.toggle('active', i === activeIdx));

            async function chooseTeam(team) {
                input.value = team.name;
                closeList();
                if (!team.logo) { status.textContent = 'Brak logo w bazie – wgraj plik ręcznie.'; return; }
                status.textContent = 'Pobieranie logo…';
                const sources = [team.logo].concat(team.alts || []);
                for (const url of sources) {
                    try {
                        loadedLogos[teamKey] = await fetchLogo(url);
                        status.textContent = 'Logo wczytane: ' + team.name;
                        renderGraphic();
                        return;
                    } catch (err) {
                        console.warn('Logo source failed, trying next:', url, err);
                    }
                }
                status.textContent = 'Nie udało się pobrać logo – wgraj plik ręcznie.';
            }

            async function runSearch(query) {
                const myReq = ++reqId;
                loader.classList.remove('hidden');
                try {
                    const cacheKey = ((getApiKey() && kind === 'team') ? 'k:' : 'w:') + kind + ':' + query.toLowerCase();
                    let teams = searchCache.get(cacheKey);
                    if (!teams) { teams = await searchTeams(query, kind); searchCache.set(cacheKey, teams); }
                    if (myReq !== reqId) return;

                    results.innerHTML = '<div class="px-4 py-2.5 text-[11px] font-bold text-slate-400 tracking-wider uppercase border-b border-slate-100 bg-slate-50 sticky top-0">Wyniki wyszukiwania</div>';
                    results.classList.remove('hidden');
                    activeIdx = -1;

                    if (!teams.length) {
                        results.insertAdjacentHTML('beforeend', '<div class="p-4 text-xs text-slate-500 text-center font-medium">' + (kind === 'competition' ? 'Brak rozgrywek' : 'Brak klubów') + ' z logo dla tej frazy. Spróbuj pełnej nazwy lub wgraj plik.</div>');
                        return;
                    }

                    teams.forEach(team => {
                        const item = document.createElement('div');
                        item.className = 'result-item flex items-center space-x-3.5 p-3 hover:bg-slate-50 cursor-pointer border-b border-slate-100 last:border-0 transition';
                        item.innerHTML = `
                            <div class="w-10 h-10 border border-slate-200 rounded-lg flex items-center justify-center p-1 bg-white shrink-0">
                                <img src="${escapeHtml(team.thumb)}" class="w-full h-full object-contain" alt="" loading="lazy">
                            </div>
                            <div class="overflow-hidden">
                                <div class="text-sm font-bold text-slate-900 truncate">${escapeHtml(team.name)}</div>
                                <div class="text-xs text-slate-500 font-medium truncate">${escapeHtml(team.sub)}</div>
                            </div>`;
                        item.addEventListener('mousedown', ev => { ev.preventDefault(); chooseTeam(team); });
                        item._team = team;
                        results.appendChild(item);
                    });
                } catch (err) {
                    console.error('Search error:', err);
                    if (myReq !== reqId) return;
                    results.innerHTML = '<div class="p-4 text-xs text-red-600 text-center font-medium">Błąd wyszukiwania (' + escapeHtml(err.message) + '). Spróbuj ponownie lub wgraj logo plikiem.</div>';
                    results.classList.remove('hidden');
                } finally {
                    if (myReq === reqId) loader.classList.add('hidden');
                }
            }

            input.addEventListener('input', e => {
                const q = e.target.value.trim();
                clearTimeout(timer);
                status.textContent = '';
                if (!q && teamKey === 'comp') { loadedLogos.comp = null; renderGraphic(); }   // emptied field = no competition logo
                if (q.length < 2) { reqId++; loader.classList.add('hidden'); closeList(); return; }
                timer = setTimeout(() => runSearch(q), 400);
            });

            input.addEventListener('focus', () => {
                if (results.children.length) results.classList.remove('hidden');
            });

            input.addEventListener('keydown', e => {
                const list = rows();
                if (results.classList.contains('hidden') || !list.length) return;
                if (e.key === 'ArrowDown') { e.preventDefault(); activeIdx = (activeIdx + 1) % list.length; highlight(); }
                else if (e.key === 'ArrowUp') { e.preventDefault(); activeIdx = (activeIdx - 1 + list.length) % list.length; highlight(); }
                else if (e.key === 'Enter' && activeIdx >= 0) { e.preventDefault(); chooseTeam(list[activeIdx]._team); }
                else if (e.key === 'Escape') closeList();
            });

            document.addEventListener('click', e => {
                if (!input.contains(e.target) && !results.contains(e.target)) closeList();
            });
        }

        setupTeamSearch('team1Input', 'team1Loader', 'team1Results', 'team1Status', 'team1');
        setupTeamSearch('team2Input', 'team2Loader', 'team2Results', 'team2Status', 'team2');
        setupTeamSearch('compInput', 'compLoader', 'compResults', 'compStatus', 'comp', 'competition');

        // ---------- PNG download ----------
        const triggerDownload = () => {
            const t1 = document.getElementById('team1Input').value.trim() || 'Gospodarz';
            const t2 = document.getElementById('team2Input').value.trim() || 'Gosc';
            const [s1, s2] = getDisplayValues();
            try {
                const link = document.createElement('a');
                link.download = `SektorDiscord_${t1}_${s1}-${s2}_${t2}${theme === 'light' ? '_bialy' : ''}.png`;
                link.href = canvas.toDataURL('image/png');
                link.click();
            } catch (err) {
                alert('Nie można wyeksportować grafiki (logo z zewnętrznego źródła blokuje eksport). Wgraj logo jako plik i spróbuj ponownie.');
            }
        };
        document.getElementById('downloadBtnHeader').addEventListener('click', triggerDownload);
        document.getElementById('downloadBtnMain').addEventListener('click', triggerDownload);

        renderGraphic();
    </script>
</body>
</html>
